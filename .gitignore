dist/

# Firebase client config — generated by `flutterfire configure`, kept out of
# git because GitHub's secret scanner flags the AIza… key pattern on push.
# These are project identifiers, not credentials (they ship inside every APK);
# firestore.rules + App Check are what actually guard the data. Copy the
# .template files and fill them in, or re-run flutterfire configure. See
# manual-task.md M15.
lib/firebase_options.dart
android/app/google-services.json

# Screenshot rig build products. The finished PNGs and GIFs in
# docs/screenshots/ are committed (the README needs them); these are not.
# tool/screenshots/capture.sh and build_font.py regenerate both.
docs/screenshots/film/
tool/screenshots/DayForgeSans-*.ttf
