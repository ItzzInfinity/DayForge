rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All app data lives under users/{uid}; only the owner may touch it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
